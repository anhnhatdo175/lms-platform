# Frontend Environment Variables — Vite + React
# Copy file này thành .env và điền giá trị thực
# LƯU Ý: Tất cả biến ở đây đều có prefix VITE_ và sẽ PUBLIC trong JS bundle
#        Tuyệt đối KHÔNG đặt secret, password, hay private key vào đây

# ========================
# API Backend
# ========================
# API qua cùng origin; Vite proxy /api tới backend local để cookie HttpOnly hoạt động
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Timeout cho HTTP request (ms)
VITE_API_TIMEOUT=10000

# ========================
# App Config
# ========================
VITE_APP_NAME=LMS

# ========================
# Môi trường (dev | staging | production)
# ========================
VITE_ENV=development
