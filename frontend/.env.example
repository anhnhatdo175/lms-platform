# Frontend Environment Variables — Vite + React
# Copy file này thành .env và điền giá trị thực
# LƯU Ý: Tất cả biến ở đây đều có prefix VITE_ và sẽ PUBLIC trong JS bundle
#        Tuyệt đối KHÔNG đặt secret, password, hay private key vào đây

# ========================
# API Backend
# ========================
# URL gốc của Spring Boot backend
VITE_API_BASE_URL=http://localhost:8080/api

# Timeout cho HTTP request (ms)
VITE_API_TIMEOUT=10000

# ========================
# App Config
# ========================
VITE_APP_NAME=LMS

# ========================
# Môi trường (dev | staging | production)
# ========================
VITE_ENV=development
