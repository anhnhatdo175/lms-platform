# Root .env — dùng cho docker-compose
# Copy file này thành .env và điền giá trị thực
# File .env đã được ignore bởi .gitignore

# ========================
# Database
# ========================
DB_ROOT_PASSWORD=your_root_password
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=your_db_password

# ========================
# Spring Boot
# ========================
SPRING_PROFILES_ACTIVE=dev
# Tạo giá trị mới bằng: openssl rand -base64 32
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ISSUER=lms-platform
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P14D
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
LMS_BOOTSTRAP_ADMIN_EMAIL=
LMS_BOOTSTRAP_ADMIN_PASSWORD=
LMS_BOOTSTRAP_ADMIN_NAME=LMS Administrator

# ========================
# SMTP relay (optional; required for password recovery)
# ========================
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
PASSWORD_RESET_URL=http://localhost/

# ========================
# S3-compatible file storage (MinIO)
# ========================
MINIO_ROOT_USER=lmsminio
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LOCAL_MINIO_PASSWORD
MINIO_BUCKET=lms-files
FILE_STORAGE_PUBLIC_ENDPOINT=http://localhost

# ========================
# Frontend (baked vào JS bundle lúc build)
# ========================
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=LMS
